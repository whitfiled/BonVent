<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">

	<!-- Palette -->
	<Color x:Key="PaletteNavy">#0B1533</Color>
	<Color x:Key="PaletteBlue">#0D6EFD</Color>
	<Color x:Key="PaletteBlue2">#1936AB</Color>
	<Color x:Key="PaletteCyan">#22CFE5</Color>
	<Color x:Key="PaletteIvory">#FAF8F4</Color>
	<Color x:Key="PaletteWhite">#FFFFFF</Color>
	<Color x:Key="PaletteSlate">#56627A</Color>

	<!-- Application colors -->
	<Color x:Key="Background">#FAF8F4</Color>
	<Color x:Key="Surface">#FFFFFF</Color>
	<Color x:Key="SurfaceDark">#000000</Color>
	<Color x:Key="Border">#CED4DA</Color>

	<Color x:Key="Primary">#0D6EFD</Color>
	<Color x:Key="Secondary">#56627A</Color>
	<Color x:Key="Success">#24EB34</Color>
	<Color x:Key="Danger">#FF0000</Color>
	<Color x:Key="Warning">#FFC107</Color>
	<Color x:Key="Info">#22CFE5</Color>
	<Color x:Key="Light">#FFFFFF</Color>
	<Color x:Key="Black">#000000</Color>
	<Color x:Key="Navy">#1936AB</Color>

	<!-- Subtle colors -->
	<Color x:Key="PrimarySubtle">#CFE2FF</Color>
	<Color x:Key="SecondarySubtle">#E2E3E5</Color>
	<Color x:Key="SuccessSubtle">#D1E7DD</Color>
	<Color x:Key="DangerSubtle">#F8D7DA</Color>
	<Color x:Key="WarningSubtle">#FFF3CD</Color>
	<Color x:Key="InfoSubtle">#CFF4FC</Color>
	<Color x:Key="LightSubtle">#FCFCFD</Color>
	<Color x:Key="DarkSubtle">#CED4DA</Color>

	<Color x:Key="BodyBackground">#FFFFFF</Color>
	<Color x:Key="Transparent">Transparent</Color>

	<!-- Brushes -->
	<SolidColorBrush x:Key="PrimaryBrush"
                     Color="{StaticResource Primary}" />

	<SolidColorBrush x:Key="SecondaryBrush"
                     Color="{StaticResource Secondary}" />

	<SolidColorBrush x:Key="SuccessBrush"
                     Color="{StaticResource Success}" />

	<SolidColorBrush x:Key="DangerBrush"
                     Color="{StaticResource Danger}" />

	<SolidColorBrush x:Key="WarningBrush"
                     Color="{StaticResource Warning}" />

	<SolidColorBrush x:Key="InfoBrush"
                     Color="{StaticResource Info}" />

	<SolidColorBrush x:Key="BackgroundBrush"
                     Color="{StaticResource Background}" />

	<SolidColorBrush x:Key="SurfaceBrush"
                     Color="{StaticResource Surface}" />

	<SolidColorBrush x:Key="SurfaceDarkBrush"
                     Color="{StaticResource SurfaceDark}" />

	<SolidColorBrush x:Key="BorderBrush"
                     Color="{StaticResource Border}" />

	<SolidColorBrush x:Key="WhiteBrush"
                     Color="{StaticResource PaletteWhite}" />

	<SolidColorBrush x:Key="BlackBrush"
                     Color="{StaticResource Black}" />

	<SolidColorBrush x:Key="NavyBrush"
                     Color="{StaticResource Navy}" />
</ResourceDictionary>