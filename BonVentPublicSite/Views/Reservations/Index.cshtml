@model BonVentPublicSite.Models.PublicReservationForm
@{
    ViewData["Title"] = "Make a reservation";
}

<h1>Make a reservation</h1>

<div asp-validation-summary="ModelOnly"></div>

<form asp-action="Index" method="post">
    <label asp-for="FirstName"></label>
    <input asp-for="FirstName" />
    <span asp-validation-for="FirstName"></span>

    <label asp-for="LastName"></label>
    <input asp-for="LastName" />
    <span asp-validation-for="LastName"></span>

    <label asp-for="Email"></label>
    <input asp-for="Email" type="email" />
    <span asp-validation-for="Email"></span>

    <label asp-for="Phone"></label>
    <input asp-for="Phone" />
    <span asp-validation-for="Phone"></span>

    <label asp-for="Address"></label>
    <input asp-for="Address" />
    <span asp-validation-for="Address"></span>

    <label asp-for="CheckIn"></label>
    <input asp-for="CheckIn" type="date" />
    <span asp-validation-for="CheckIn"></span>

    <label asp-for="CheckOut"></label>
    <input asp-for="CheckOut" type="date" />
    <span asp-validation-for="CheckOut"></span>

    <label asp-for="RoomId">Room</label>
    <select asp-for="RoomId">
        <option value="">Select an available room</option>
        @foreach (var room in Model.AvailableRooms)
        {
            <option value="@room.Id">
                Room @room.Number - @room.RoomTypeName - @room.BaseRate.ToString("C") per night
            </option>
        }
    </select>
    <span asp-validation-for="RoomId"></span>

    <button type="submit">Request reservation</button>
</form>
